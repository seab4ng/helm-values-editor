{
  "name": "helm-values-editor",
  "version": "1.2.4",
  "description": "Browser-based editor for Helm chart values files — search, batch-edit, and write back to disk without a terminal.",
  "homepage": "https://github.com/seab4ng/helm-values-editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/seab4ng/helm-values-editor.git"
  },
  "bugs": {
    "url": "https://github.com/seab4ng/helm-values-editor/issues"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "npx serve app -p 3000",
    "test": "node --test tests/unit.js",
    "test:e2e": "npx playwright test",
    "test:coverage": "node --test --experimental-test-coverage tests/unit.js",
    "lint": "eslint app/lib.js tests/ playwright.config.js",
    "lint:fix": "eslint --fix app/lib.js tests/ playwright.config.js",
    "format": "prettier --write app/lib.js tests/ playwright.config.js",
    "format:check": "prettier --check app/lib.js tests/ playwright.config.js"
  },
  "dependencies": {
    "js-yaml": "4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "serve": "^14.2.6"
  }
}
